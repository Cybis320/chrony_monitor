#!/bin/bash
#
# Kept so the old one-liner keeps working:
#
#   curl -fsSL https://raw.githubusercontent.com/Cybis320/chrony_monitor/main/install | sudo bash
#
# It now runs install.sh, the installer every CC RMS utility shares the shape of.

set -euo pipefail

SELF="${BASH_SOURCE[0]:-}"
if [ -n "$SELF" ] && [ -f "$(dirname "$SELF")/install.sh" ]; then
    exec bash "$(dirname "$SELF")/install.sh" "$@"
fi
curl -fsSL "https://raw.githubusercontent.com/Cybis320/chrony_monitor/${CHRONY_MONITOR_BRANCH:-main}/install.sh" | bash
